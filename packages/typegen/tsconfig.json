{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "strict": true,
    "strictNullChecks": true,
    "outDir": "lib",
    "verbatimModuleSyntax": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["tests/**"]
}
