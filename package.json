{
  "name": "mdn",
  "version": "0.0.1",
  "packageManager": "pnpm@10.6.5",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "generate": "tsx ./generate-bcd-types.ts"
  },
  "dependencies": {
    "compare-versions": "^6.1.1",
    "pathe": "^2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^6.0.12",
    "@sxzz/eslint-config": "^7.0.0",
    "@types/node": "^22.15.16",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.0",
    "tsdown": "^0.11.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
